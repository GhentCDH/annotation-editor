d-container\",\n            key: isDarkMode.value ? \"dark\" : \"light\",\n          },\n\n          h(\n            \"div\",\n            {\n              class: \"kotlin-playground\",\n              ref: kotlinPlayground,\n              ...settings.value,\n            },\n            [\n              h(\"pre\", files.value[0]),\n              // Hidden dependency\n              files.value.length > 1\n                ? files.value.map((content, index) =>\n                    index === 0\n                      ? null\n                      : h(\"textarea\", { class: \"hidden-dependency\", readonly: \"\" }, content),\n                  )\n                : null,\n            ],\n          ),\n        ),\n      ]);\n  },\n});\n"],"mappings":";;;;;;AAOA,+BAAe,gBAAgB;CAC7B,MAAM;CAEN,OAAO;;;;;;EAML,OAAO;GACL,MAAM;GACN,UAAU;EACZ;;;;;;EAOA,OAAO;;;;;;EAOP,UAAU;CACZ;CAEA,MAAM,OAAO;EACX,MAAM,aAAa,YAAY;EAE/B,MAAM,mBAAmB,WAA2B;EAEpD,MAAM,QAAQ,eAAe,KAAK,MAAM,WAAW,MAAM,KAAK,CAAC,CAAa;EAE5E,MAAM,WAAW,gBAAgB;GAC/B,OAAO,WAAW,QAAQ,YAAY;GACtC,GAAI,KAAK,MAAM,mBAAmB,MAAM,YAAY,IAAI,CAAC;EAC3D,EAAE;EAEF,MAAM,mBAAmB,YAA2B;GAClD,IAAI,kBAAkB;GAEtB,MAAM,EAAE,SAAS,eAAe,MAAM;;IACQ;;GAI9C,WAAW,iBAAiB,KAAM;EACpC;EAEA,gBAAgB;GACd,eAAe,kBAAkB,iBAAiB,GAAG,EACnD,OAAO,OACT,CAAC;EACH,CAAC;EAED,aACE,EAAE,OAAO,EAAE,OAAO,4BAA4B,GAAG,CAC/C,MAAM,QAAQ,EAAE,OAAO,EAAE,OAAO,SAAS,GAAG,mBAAmB,MAAM,KAAK,CAAC,IAAI,MAC/E,EACE,OACA;GACE,OAAO;GACP,KAAK,WAAW,QAAQ,SAAS;EACnC,GAEA,EACE,OACA;GACE,OAAO;GACP,KAAK;GACL,GAAG,SAAS;EACd,GACA,CACE,EAAE,OAAO,MAAM,MAAM,EAAE,GAEvB,MAAM,MAAM,SAAS,IACjB,MAAM,MAAM,KAAK,SAAS,UACxB,UAAU,IACN,OACA,EAAE,YAAY;GAAE,OAAO;GAAqB,UAAU;EAAG,GAAG,OAAO,CACzE,IACA,IACN,CACF,CACF,CACF,CAAC;CACL;AACF,CAAC"}