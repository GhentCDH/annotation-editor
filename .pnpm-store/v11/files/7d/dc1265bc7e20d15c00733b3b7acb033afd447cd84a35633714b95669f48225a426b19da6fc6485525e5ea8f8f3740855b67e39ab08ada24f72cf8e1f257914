{"version":3,"file":"blog.js","sourceRoot":"","sources":["../../src/shared/blog.ts"],"names":[],"mappings":"","sourcesContent":["import type { ReadingTime } from \"@vuepress/plugin-reading-time\";\n\nimport type { Author } from \"./author.js\";\n\nexport type PageType = \"article\" | \"home\" | \"slide\" | \"page\";\n\nexport interface PageInfoData extends Record<string, unknown> {\n  /** Article title */\n  title: string;\n\n  /** Article short title */\n  shortTitle: string;\n\n  /** Page icon */\n  icon?: string;\n\n  /**\n   * Whether this page should be indexed\n   *\n   * Used in other functions, e.g.: sidebar and catalog\n   */\n  index?: boolean;\n\n  /** The order of this page in same directory */\n  order?: number;\n}\n\nexport interface ArticleInfoData extends PageInfoData {\n  /** Type */\n  type: PageType;\n\n  /** Article author */\n  author?: Author | false;\n\n  /** Writing date info */\n  date?: number;\n\n  /** Article category */\n  category?: string[];\n\n  /** Article tag */\n  tag?: string[];\n\n  /** Reading time info */\n  readingTime?: ReadingTime;\n\n  /** Article excerpt */\n  excerpt: string;\n\n  /** Whether is encrypted */\n  isEncrypted?: true;\n\n  /** Whether is original */\n  isOriginal?: true;\n\n  /** Sticky info */\n  sticky?: number | boolean;\n\n  /** Cover image */\n  cover?: string;\n}\n"]}