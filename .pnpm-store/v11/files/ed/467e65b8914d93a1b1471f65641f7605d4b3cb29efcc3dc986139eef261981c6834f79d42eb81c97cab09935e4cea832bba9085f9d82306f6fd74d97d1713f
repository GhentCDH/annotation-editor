{"version":3,"file":"useRtl-D1MtsePv.js","names":[],"sources":["../src/client/utils/index.ts","../src/client/composables/useRtl.ts"],"sourcesContent":["/**\n * Get DOM element by selector\n *\n * 通过选择器获取 DOM 元素\n *\n * @example\n *   import { getElement } from '@vuepress/plugin-rtl/client'\n *\n *   const htmlElement = getElement('html')\n *   const bodyElement = getElement('body')\n *   const customElement = getElement('.my-class')\n *\n * @param selector - CSS selector\n * @returns The DOM element or null if not found\n */\nexport const getElement = (selector: string): HTMLElement | null =>\n  selector === 'html'\n    ? document.documentElement\n    : selector === 'body'\n      ? document.body\n      : document.querySelector(selector)\n","import { entries } from '@vuepress/helper/client'\nimport { watchImmediate } from '@vueuse/core'\nimport { onMounted } from 'vue'\nimport { useRouteLocale } from 'vuepress/client'\n\nimport { getElement } from '../utils/index.js'\n\n/**\n * Composable to use RTL functionality\n *\n * 使用 RTL 功能的组合式函数\n *\n * @example\n *   import { useRtl } from '@vuepress/plugin-rtl'\n *\n *   // Use in client side\n *   useRtl(['/ar/', '/he/'], {\n *     html: { dir: 'rtl' },\n *     body: { class: 'rtl-layout' },\n *   })\n *\n * @default selectorOptions { html: { dir: 'rtl' } }\n * @param rtlLocalePaths - RTL locale paths\n * @param selectorOptions - RTL selector options\n */\nexport const useRtl = (\n  rtlLocalePaths: string[],\n  // oxlint-disable-next-line unicorn/no-object-as-default-parameter\n  selectorOptions: Record<string, Record<string, string>> = {\n    html: { dir: 'rtl' },\n  },\n): void => {\n  const routeLocale = useRouteLocale()\n\n  const toggleRTL = (localePath: string): void => {\n    const isRTL = rtlLocalePaths.includes(localePath)\n\n    entries(selectorOptions).forEach(([selector, attrs]) => {\n      const element = getElement(selector)\n\n      if (element) {\n        entries(attrs).forEach(([attr, value]) => {\n          if (attr === 'class') element.classList.toggle(value, isRTL)\n          else if (isRTL) element.setAttribute(attr, value)\n          else element.removeAttribute(attr)\n        })\n      }\n    })\n\n    if (isRTL) document.documentElement.style.setProperty('direction', 'rtl')\n    else document.documentElement.style.removeProperty('direction')\n  }\n\n  onMounted(() => {\n    watchImmediate(routeLocale, toggleRTL)\n  })\n}\n"],"mappings":"iLAeA,MAAa,EAAc,GACzB,IAAa,OACT,SAAS,gBACT,IAAa,OACX,SAAS,KACT,SAAS,cAAc,CAAQ,ECK1B,GACX,EAEA,EAA0D,CACxD,KAAM,CAAE,IAAK,KAAM,CACrB,IACS,CACT,IAAM,EAAc,EAAe,EAE7B,EAAa,GAA6B,CAC9C,IAAM,EAAQ,EAAe,SAAS,CAAU,EAEhD,EAAQ,CAAe,EAAE,SAAS,CAAC,EAAU,KAAW,CACtD,IAAM,EAAU,EAAW,CAAQ,EAE/B,GACF,EAAQ,CAAK,EAAE,SAAS,CAAC,EAAM,KAAW,CACpC,IAAS,QAAS,EAAQ,UAAU,OAAO,EAAO,CAAK,EAClD,EAAO,EAAQ,aAAa,EAAM,CAAK,EAC3C,EAAQ,gBAAgB,CAAI,CACnC,CAAC,CAEL,CAAC,EAEG,EAAO,SAAS,gBAAgB,MAAM,YAAY,YAAa,KAAK,EACnE,SAAS,gBAAgB,MAAM,eAAe,WAAW,CAChE,EAEA,MAAgB,CACd,EAAe,EAAa,CAAS,CACvC,CAAC,CACH"}