{"version":3,"file":"config.js","names":["Catalog"],"sources":["../../src/client/components/Catalog.ts","../../src/client/config.ts"],"sourcesContent":["import type { ExactLocaleConfig } from '@vuepress/helper/client'\nimport {\n  endsWith,\n  ensureEndingSlash,\n  ensureLeadingSlash,\n  entries,\n  isNumber,\n  isPlainObject,\n  isString,\n  keys,\n  startsWith,\n  useLocale,\n} from '@vuepress/helper/client'\nimport type { VNode } from 'vue'\nimport { computed, defineComponent, h, shallowRef } from 'vue'\nimport { RouteLink, useData } from 'vuepress/client'\n\nimport type { CatalogPluginLocaleData } from '../../shared/index.js'\nimport type { CatalogInfo } from '../helpers/index.js'\nimport { useCatalogInfoGetter } from '../helpers/index.js'\n\nimport '../styles/catalog.scss'\n\ndeclare const __CATALOG_LOCALES__: ExactLocaleConfig<CatalogPluginLocaleData>\n\nexport interface CatalogProps {\n  base?: string\n  level?: 1 | 2 | 3\n}\n\ninterface CatalogData extends CatalogInfo {\n  level: number\n  base: string\n  path: string\n  children?: CatalogData[]\n}\n\nexport default defineComponent({\n  name: 'Catalog',\n\n  props: {\n    /**\n     * Catalog Base\n     *\n     * 目录的基础路径\n     *\n     * @default current route base\n     */\n    base: String,\n\n    /**\n     * Max level of catalog\n     *\n     * Only 1,2,3 are supported\n     *\n     * Catalog 的最大层级\n     *\n     * 目前仅支持 1,2,3\n     *\n     * @default 3\n     */\n    level: {\n      type: Number,\n      default: 3,\n    },\n\n    /**\n     * Whether show index for catalog\n     *\n     * 目录是否显示索引\n     */\n    index: Boolean,\n\n    /**\n     * Whether hide `Category` title\n     *\n     * 是否隐藏 `目录` 标题\n     *\n     * @default false\n     */\n    hideHeading: Boolean,\n  },\n\n  setup(props) {\n    const { page, routes, site } = useData()\n    const catalogInfoGetter = useCatalogInfoGetter()\n    const locale = useLocale(__CATALOG_LOCALES__)\n\n    const getCatalogData = (): CatalogData[] =>\n      entries(routes.value)\n        .map(([path, { meta }]) => {\n          const info = catalogInfoGetter(meta)\n\n          if (!info) return null\n\n          const level = path.split('/').length\n\n          return Object.assign(\n            {\n              level: endsWith(path, `/`) ? level - 2 : level - 1,\n              base: path.replace(/\\/[^/]+\\/?$/u, '/'),\n              path,\n            },\n            info,\n          )\n        })\n        .filter(\n          (item): item is CatalogData =>\n            isPlainObject(item) && isString(item.title),\n        )\n\n    const catalogInfo = shallowRef(getCatalogData())\n\n    const catalogData = computed(() => {\n      const basePath = props.base\n        ? ensureLeadingSlash(ensureEndingSlash(props.base))\n        : page.value.path.replace(/\\/[^/]+$/u, '/')\n      const baseDepth = basePath.split('/').length - 2\n      const result: CatalogData[] = []\n\n      catalogInfo.value\n        .filter(({ level, path }) => {\n          // filter those under current base\n          if (!startsWith(path, basePath) || path === basePath) return false\n\n          if (basePath === '/') {\n            const otherLocales = keys(site.value.locales).filter(\n              (item) => item !== '/',\n            )\n\n            // exclude 404 page and other locales\n            if (\n              path === '/404.html' ||\n              otherLocales.some((localePath) => startsWith(path, localePath))\n            )\n              return false\n          }\n\n          return (\n            // level is less than or equal to max level\n            level - baseDepth <= props.level\n          )\n        })\n        .sort(\n          (\n            { title: titleA, level: levelA, order: orderA },\n            { title: titleB, level: levelB, order: orderB },\n          ) => {\n            const level = levelA - levelB\n\n            if (level) return level\n\n            // infoA order is absent\n            if (!isNumber(orderA)) {\n              // infoB order is absent\n              if (!isNumber(orderB))\n                // compare title\n                return titleA.localeCompare(titleB)\n\n              // infoB order is present\n              return orderB\n            }\n\n            // infoB order is absent\n            if (!isNumber(orderB)) return orderA\n\n            // now we are sure both order exist\n\n            // infoA order is positive\n            if (orderA > 0) {\n              if (orderB > 0) return orderA - orderB\n\n              return -1\n            }\n\n            // both order are negative\n            if (orderB < 0) return orderA - orderB\n\n            return 1\n          },\n        )\n        .forEach((info) => {\n          const { base, level } = info\n\n          switch (level - baseDepth) {\n            case 1: {\n              result.push(info)\n              break\n            }\n\n            case 2: {\n              const parent = result.find((item) => item.path === base)\n\n              if (parent) (parent.children ??= []).push(info)\n              break\n            }\n\n            default: {\n              const grandParent = result.find(\n                (item) => item.path === base.replace(/\\/[^/]+\\/?$/u, '/'),\n              )\n\n              if (grandParent) {\n                const parent = grandParent.children?.find(\n                  (item) => item.path === base,\n                )\n\n                if (parent) (parent.children ??= []).push(info)\n              }\n            }\n          }\n        })\n\n      return result\n    })\n\n    return (): VNode => {\n      const isDeep = catalogData.value.some((item) => item.children)\n\n      return h('div', { class: ['vp-catalog', { index: props.index }] }, [\n        props.hideHeading\n          ? null\n          : h('h2', { class: 'vp-catalog-main-title' }, locale.value.title),\n        catalogData.value.length > 0\n          ? h(\n              props.index ? 'ol' : 'ul',\n              { class: ['vp-catalog-list', { deep: isDeep }] },\n              catalogData.value.map(\n                ({ children = [], title, path, content }) => {\n                  const childLink = h(\n                    RouteLink,\n                    { class: 'vp-catalog-title', to: path },\n                    () => (content ? h(content) : title),\n                  )\n\n                  return h(\n                    'li',\n                    { class: 'vp-catalog-item' },\n                    isDeep\n                      ? [\n                          h(\n                            'h3',\n                            {\n                              id: title,\n                              class: [\n                                'vp-catalog-child-title',\n                                { 'has-children': children.length },\n                              ],\n                            },\n                            [\n                              h('a', {\n                                'href': `#${title}`,\n                                'class': 'vp-catalog-header-anchor',\n                                'aria-hidden': true,\n                              }),\n                              childLink,\n                            ],\n                          ),\n                          children.length > 0\n                            ? h(\n                                props.index ? 'ol' : 'ul',\n                                { class: 'vp-child-catalogs' },\n                                children.map(\n                                  ({\n                                    children: grandChildren = [],\n                                    content: childContent,\n                                    path: childPath,\n                                    title: childTitle,\n                                  }) =>\n                                    h('li', { class: 'vp-child-catalog' }, [\n                                      h(\n                                        'div',\n                                        {\n                                          class: [\n                                            'vp-catalog-sub-title',\n                                            {\n                                              'has-children':\n                                                grandChildren.length,\n                                            },\n                                          ],\n                                        },\n                                        [\n                                          h('a', {\n                                            href: `#${childTitle}`,\n                                            class: 'vp-catalog-header-anchor',\n                                          }),\n                                          h(\n                                            RouteLink,\n                                            {\n                                              class: 'vp-catalog-title',\n                                              to: childPath,\n                                            },\n                                            () =>\n                                              childContent\n                                                ? h(childContent)\n                                                : childTitle,\n                                          ),\n                                        ],\n                                      ),\n                                      grandChildren.length > 0\n                                        ? h(\n                                            props.index ? 'ol' : 'div',\n                                            {\n                                              class: props.index\n                                                ? 'vp-sub-catalogs'\n                                                : 'vp-sub-catalogs-wrapper',\n                                            },\n                                            grandChildren.map(\n                                              ({\n                                                content: grandChildContent,\n                                                path: grandChildPath,\n                                                title: grandChildTitle,\n                                              }) =>\n                                                props.index\n                                                  ? h(\n                                                      'li',\n                                                      {\n                                                        class: 'vp-sub-catalog',\n                                                      },\n                                                      h(\n                                                        RouteLink,\n                                                        { to: grandChildPath },\n                                                        () =>\n                                                          grandChildContent\n                                                            ? h(\n                                                                grandChildContent,\n                                                              )\n                                                            : grandChildTitle,\n                                                      ),\n                                                    )\n                                                  : h(\n                                                      RouteLink,\n                                                      {\n                                                        class:\n                                                          'vp-sub-catalog-link',\n                                                        to: grandChildPath,\n                                                      },\n                                                      () =>\n                                                        grandChildContent\n                                                          ? h(grandChildContent)\n                                                          : grandChildTitle,\n                                                    ),\n                                            ),\n                                          )\n                                        : null,\n                                    ]),\n                                ),\n                              )\n                            : null,\n                        ]\n                      : h(\n                          'div',\n                          { class: 'vp-catalog-child-title' },\n                          childLink,\n                        ),\n                  )\n                },\n              ),\n            )\n          : h('p', { class: 'vp-empty-catalog' }, locale.value.empty),\n      ])\n    }\n  },\n})\n","import { hasGlobalComponent } from '@vuepress/helper/client'\nimport { defineClientConfig } from 'vuepress/client'\n\nimport Catalog from './components/Catalog.js'\nimport { injectCatalogInfoGetter } from './helpers/index.js'\n\nimport './styles/vars.css'\n\nexport default defineClientConfig({\n  enhance: ({ app }) => {\n    injectCatalogInfoGetter(app)\n    if (!hasGlobalComponent('Catalog', app)) app.component('Catalog', Catalog)\n  },\n})\n"],"mappings":"0bAqCA,IAAA,EAAe,EAAgB,CAC7B,KAAM,UAEN,MAAO,CAQL,KAAM,OAaN,MAAO,CACL,KAAM,OACN,QAAS,CACX,EAOA,MAAO,QASP,YAAa,OACf,EAEA,MAAM,EAAO,CACX,GAAM,CAAE,OAAM,SAAQ,QAAS,EAAQ,EACjC,EAAoB,EAAqB,EACzC,EAAS,EAAU,mBAAmB,EAyBtC,EAAc,EAtBlB,EAAQ,EAAO,KAAK,EACjB,KAAK,CAAC,EAAM,CAAE,WAAY,CACzB,IAAM,EAAO,EAAkB,CAAI,EAEnC,GAAI,CAAC,EAAM,OAAO,KAElB,IAAM,EAAQ,EAAK,MAAM,GAAG,EAAE,OAE9B,OAAO,OAAO,OACZ,CACE,MAAO,EAAS,EAAM,GAAG,EAAI,EAAQ,EAAI,EAAQ,EACjD,KAAM,EAAK,QAAQ,eAAgB,GAAG,EACtC,MACF,EACA,CACF,CACF,CAAC,EACA,OACE,GACC,EAAc,CAAI,GAAK,EAAS,EAAK