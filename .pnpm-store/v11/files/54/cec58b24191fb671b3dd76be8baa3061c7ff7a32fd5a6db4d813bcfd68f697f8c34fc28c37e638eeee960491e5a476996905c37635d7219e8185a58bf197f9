.value = !shouldRemember.value\n                      },\n                    }),\n                    h(\n                      'label',\n                      { for: 'remember-redirect' },\n                      locale.value?.remember,\n                    ),\n                  ]),\n                  h('div', { class: 'redirect-modal-actions' }, [\n                    h(\n                      'button',\n                      {\n                        type: 'button',\n                        class: 'redirect-modal-action primary',\n                        onClick: () => {\n                          redirect()\n                        },\n                      },\n                      locale.value?.switch,\n                    ),\n                    h(\n                      'button',\n                      {\n                        type: 'button',\n                        class: 'redirect-modal-action',\n                        onClick: () => {\n                          persistUserAction()\n                        },\n                      },\n                      locale.value?.cancel,\n                    ),\n                  ]),\n                ],\n              ),\n            )\n          : null,\n      )\n  },\n})\n"],"mappings":"oQASA,IAAA,EAAe,EAAgB,CAC7B,KAAM,gBAEN,MAAO,EAEP,MAAM,EAAO,CACX,GAAM,CACJ,iBACA,gBACA,SACA,oBACA,YACE,EAAY,CAAK,EAEf,EAAO,EAAiB,EAExB,EAAW,EAAc,CAAI,EAWnC,OATA,MAAgB,CACd,EAAK,MAAQ,SAAS,KAGtB,EAAe,EAAgB,GAAU,CACvC,EAAS,MAAQ,CACnB,CAAC,CACH,CAAC,MAGC,EAAE,EAAiB,CAAE,KAAM,kBAAmB,MAC5C,EAAc,MACV,EACE,MACA,CAAE,IAAK,OAAQ,MAAO,qBAAsB,EAC5C,EACE,MACA,CACE,IAAK,QACL,MAAO,wBACT,EACA,CACE,EACE,MACA,CAAE,MAAO,wBAAyB,EAClC,EAAO,OAAO,KAAK,IAAK,GAAS,EAAE,IAAK,CAAI,CAAC,CAC/C,EACA,EAAE,MAAO,CAAE,MAAO,qBAAsB,EAAG,CACzC,EAAE,QAAS,CACT,GAAI,oBACJ,KAAM,WACN,QAAS,EAAe,MACxB,aAAgB,CACd,EAAe,MAAQ,CAAC,EAAe,KACzC,CACF,CAAC,EACD,EACE,QACA,CAAE,IAAK,mBAAoB,EAC3B,EAAO,OAAO,QAChB,CACF,CAAC,EACD,EAAE,MAAO,CAAE,MAAO,wBAAyB,EAAG,CAC5C,EACE,SACA,CACE,KAAM