w new Error(`useBlogType: key ${key} is invalid`)\n\n    const configMap = typeMapRef.value[mapKey][routeLocale.value]\n    const result: BlogTypeData<T> = {\n      path: configMap.path,\n      items: [],\n    }\n\n    for (const index of configMap.indexes) {\n      const { path, meta } = resolveRoute(store[index])\n\n      result.items.push({\n        path,\n        info:\n          __BLOG_META_SCOPE__ === ''\n            ? (meta as T)\n            : (meta[__BLOG_META_SCOPE__] as T),\n      })\n    }\n\n    return result\n  })\n}\n\nif (__VUEPRESS_DEV__ && (import.meta.webpackHot || import.meta.hot)) {\n  __VUE_HMR_RUNTIME__.updateBlogType = (value: TypesMap): void => {\n    typeMapRef.value = value\n  }\n}\n"],"mappings":"iQAeA,MAAM,EAAiB,EAAW,CAAa,EAElC,EAAkB,EAAS,CAAc,EAczC,EAGX,GACqC,CACrC,GAAM,CAAE,cAAa,OAAM,eAAgB,EAExC,EAEH,OAAO,MAAe,CACpB,IAAM,EAAS,GAAO,EAAY,MAAM,MAAM,KAAO,GAErD,GAAI,CAAC,EAKH,OAHA,QAAQ,KAAK,gCAAgC,EAGtC,CAAE,KAAM,IAAK,IAAK,CAAC,CAAE,EAG9B,GAAI,EAAE,KAAU,EAAe,OAC7B,MAAU,MAAM,wBAAwB,EAAO,YAAY,EAE7D,IAAM,EAAa,EAAe,MAAM,GAAQ,EAAY,OACtD,EAA8B,CAClC,KAAM,EAAW,KACjB,IAAK,CAAC,CACR,EAEA,IAAK,GAAM,CAAC,EAAU,KAAgB,OAAO,QAAQ,EAAW,GAAG,EAAG,CACpE,EAAO,IAAI,GAAY,CAAE,KAAM,EAAY,KAAM,MAAO,CAAC,CAAE,EAE3D,IAAK,IAAM,KAAS,EAAY,QAAS,CACvC,GAAM,CAAE,OAAM,QAAS,EAAa,EAAM,EAAM,EAEhD,EAAO,IAAI,GAAU,MAAM,KAAK,CAC9B,OACA,KACE,sBAAwB,GACnB,EACA,EAAK,oBACd,CAAC,CACH,CAEI,EAAK,MAAM,OAAS,EAAY,OAClC,EAAO,aAAe,EAAO,IAAI,GAAU,MAC/C,CAEA,OAAO,CACT,CAAC,CACH,EAEI,mBAAqB,OAAO,KAAK,YAAc,OAAO,KAAK,OAC7D,oBAAoB,mBAAsB,GAA+B,CACvE,EAAe,MAAQ,CACzB,GCvEF,MAAM,EAAa,EAAW,CAAQ,EAEzB,EAAc,EAAS,CAAU,EAcjC,EAGX,GACiC,CACjC,GAAM,CAAE,cAAa,eAAgB,EAElC,EAEH,OAAO,MAAe,CACpB,IAAM,EAAS,GAAO,EAAY,MAAM,MAAM,KAAO,GAErD,GAAI,CAAC,EAKH,OAHA,QAAQ,KAAK,4BAA4B,EAGlC,CAAE,KAAM,IAAK,MAAO,CAAC,CAAE,EAGhC,GAAI,EAAE,KAAU,EAAW,OACzB,MAAU,MAAM,oBAAoB,EAAI,YAAY,EAEtD,IAAM,EAAY,EAAW,MAAM,GAAQ,EAAY,OACjD,EAA0B,CAC9B,KAAM,EAAU,KAChB,MAAO,CAAC,CACV,EAEA,IAAK,IAAM,KAAS,EAAU,QAAS,CACrC,GAAM,CAAE,OAAM,QAAS,EAAa,EAAM