Boolean) as ShareServiceOptions[];\n    });\n\n    const shareData = computed(() => {\n      const result: Record<string, string | string[]> = {};\n\n      (\n        [\"titleGetter\", \"descriptionGetter\", \"summaryGetter\", \"coverGetter\", \"tagGetter\"] as const\n      ).forEach((item) => {\n        if (isFunction(props[item])) {\n          const value = props[item](page.value);\n\n          if (value) result[item.replace(\"Getter\", \"\")] = value;\n        }\n      });\n\n      return result;\n    });\n\n    return (): VNode =>\n      h(\n        \"div\",\n        {\n          class: \"vp-share-buttons\",\n          style: props.inline ? { display: \"inline-block\" } : {},\n        },\n        services.value.map((item) =>\n          h(ShareService, {\n            config: item,\n            ...shareData.value,\n            plain: !props.colorful,\n          }),\n        ),\n      );\n  },\n});\n"],"mappings":";;;;;;;;;;AAoBA,MAAM,cAAc,SAAiB,eAAe,OAAc;CAChE,MAAM,YAAY,CAAC,iBAAiB,YAAY;CAGhD,IAAI,WAAW,OAAO,KAAK,eAAe,OAAO,GAC/C,OAAO,EAAE,OAAO;EACd,OAAO;EACP,KAAK;EACL,SAAS;EACT,WAAW;CACb,CAAC;CAIH,IAAI,WAAW,SAAS,GAAG,KAAK,SAAS,SAAS,GAAG,GACnD,OAAO,EAAE,OAAO;EAAE,OAAO;EAAW,WAAW;CAAQ,CAAC;CAG1D,OAAO,EAAE,OAAO,EAAE,OAAO,CAAC,GAAG,WAAW,OAAO,EAAE,CAAC;AACpD;AAEA,2BAAe,gBAAgB;CAC7B,MAAM;CAEN,OAAO;;;;;;EAML,QAAQ;GACN,MAAM;GACN,UAAU;EACZ;;EAGA,OAAO;;EAGP,OAAO;;EAGP,aAAa;;EAGb,KAAK;;EAGL,SAAS;;EAGT,OAAO;;EAGP,KAAK,CAAC,OAAO,MAAM;CACrB;CAEA,MAAM,OAAO;EACX,IAAI;EACJ,MAAM,EAAE,aAAa,SAAS,QAAQ;EAEtC,MAAM,YAAY,IAAI,KAAK;EAE3B,MAAM,qBAA6B;GACjC,MAAM,QAAQ,MAAM,SAAS,KAAK,MAAM;GACxC,MAAM,cACJ,MAAM,eACN,YAAY,MAAM,eAClB,eAAe,aAAa,KAC5B,eAAe,gBAAgB,KAC/B,eAAe,qBAAqB;GACtC,MAAM,MAAM,MAAM,OAAO,WAAW,SAAS;GAC7C,MAAM,QAAQ,MAAM,SAAS,eAAe,UAAU;GACtD,MAAM,QAAQ,SACX,cAAgC,4BAA4B,GAC3D,aAAa,KAAK;GACtB,MAAM,OAAO,MAAM,OAAO,YAAY,MAAM,OAAO,YAAY,MAAM;GACrE,MAAM,MAAM,QAAQ,IAAI,IACpB,KAAK,QAAQ,SAAS,SAAS,IAAI,CAAC,EAAE,KAAK,GAAG,IAC9C,SAAS,IAAI,IACX,OACA;GAEN,OAAO,MAAM,OAAO,KAAK,WAAW,mBAAmB,GAAG,WAA2B;IA