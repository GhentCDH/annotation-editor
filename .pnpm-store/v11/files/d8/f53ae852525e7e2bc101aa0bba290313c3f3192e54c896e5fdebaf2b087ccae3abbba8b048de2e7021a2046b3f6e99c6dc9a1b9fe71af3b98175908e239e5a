n = (): void => {\n    statusSessionStorage.value[routeLocale.value] = true\n    if (shouldRemember.value) statusLocalStorage.value[routeLocale.value] = true\n\n    showComponent.value = false\n  }\n\n  const redirect = (): void => {\n    void router.replace(\n      routePath.value.replace(\n        routeLocale.value,\n        redirectInfo.value!.localePath,\n      ),\n    )\n    persistUserAction()\n  }\n\n  onMounted(() => {\n    watch(routePath, () => {\n      showComponent.value = false\n    })\n\n    if (\n      redirectInfo.value &&\n      !statusSessionStorage.value[routeLocale.value] &&\n      !statusLocalStorage.value[routeLocale.value]\n    )\n      showComponent.value = true\n  })\n\n  onBeforeUnmount(() => {\n    showComponent.value = false\n  })\n\n  return {\n    showComponent,\n    shouldRemember,\n    locale,\n    persistUserAction,\n    redirect,\n  }\n}\n"],"mappings":"oNASA,MAAa,EAAe,CAC1B,OAAQ,CACN,KAAM,OACN,SAAU,EACZ,EAEA,QAAS,CACP,KAAM,OACN,SAAU,EACZ,CACF,EAiBa,EAAe,GAA2B,CACrD,GAAM,CAAE,cAAa,aAAc,EAAQ,EACrC,EAAe,EAAoB,EAAM,MAAM,EAC/C,EAAS,EAAU,EAEnB,EAAgB,EAAI,EAAK,EACzB,EAAiB,EAAI,EAAK,EAE1B,EAAS,MAAe,CAC5B,GAAI,CAAC,EAAa,MAAO,OAAO,KAEhC,GAAM,CAAE,OAAM,cAAe,EAAa,MACpC,EAAe,EAAM,QAAQ,GAC7B,EAAgB,EAAM,QAAQ,EAAY,OAEhD,MAAO,CACL,KAAM,CAAC,EAAc,CAAa,EAAE,KAAK,CAAE,UACzC,EAAK,QAAQ,KAAM,CAAI,CACzB,EACA,OAAQ,EAAa,OAAO,QAAQ,KAAM,EAAa,IAAI,EAC3D,OAAQ,EAAc,OACtB,SAAU,EAAa,QACzB,CACF,CAAC,EAEK,MAAgC,CACpC,EAAqB,MAAM,EAAY,OAAS,GAC5C,EAAe,QAAO,EAAmB,MAAM,EAAY,OAAS,IAExE,EAAc,MAAQ,EACxB,EA6BA,OAjBA,MAAgB,CACd,EAAM,MAAiB,CACrB,EAAc,MAAQ,EACxB,CAAC,EAGC,EAAa,OACb,CAAC,EAAqB,MAAM,EAAY,QACxC,CAAC,EAAmB,MAAM,EAAY,SAEtC,EAAc,MAAQ,GAC1B,CAAC,EAED,MAAsB,CACpB,EAAc,MAAQ,EACxB,CAAC,EAEM,CACL,gBACA,iBACA,SACA,oBACA,aAhC2B,CAC3B,EAAY,QACV,EAAU,MAAM,QACd,EAAY,MACZ,EAAa,MAAO,UACtB,CACF,EACA,EAAkB,CACpB,CAyBA,CACF"}