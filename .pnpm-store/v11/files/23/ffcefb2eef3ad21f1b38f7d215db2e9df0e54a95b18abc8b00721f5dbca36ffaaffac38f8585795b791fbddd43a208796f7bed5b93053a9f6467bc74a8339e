{"version":3,"file":"index.js","names":[],"sources":["../../src/node/createConverter.ts"],"sourcesContent":["import { Logger, isPlainObject } from \"@vuepress/helper\";\nimport { colors } from \"vuepress/utils\";\n\nexport interface DeprecatedLoggerOptions {\n  options: Record<string, unknown>;\n  old: string;\n  new: string;\n  msg?: string;\n  scope?: string;\n}\n\nexport interface DroppedLoggerOptions {\n  options: Record<string, unknown>;\n  old: string;\n  new?: string;\n  msg?: string;\n  scope?: string;\n}\n\nexport interface Converter {\n  deprecatedLogger: (options: DeprecatedLoggerOptions) => void;\n  droppedLogger: (options: DroppedLoggerOptions) => void;\n}\n\nexport const createConverter = (name: string): Converter => {\n  const logger = new Logger(name);\n\n  return {\n    deprecatedLogger: ({\n      options,\n      old,\n      new: newOption,\n      msg,\n      scope,\n    }: DeprecatedLoggerOptions): void => {\n      let deprecatedOptionValue: unknown;\n      let hasDeprecatedOption = false;\n\n      if (old.includes(\".\")) {\n        let temp = options;\n        const keys = old.split(\".\");\n\n        for (const [index, key] of keys.entries()) {\n          if (key in temp) {\n            if (index === keys.length - 1) {\n              hasDeprecatedOption = true;\n              deprecatedOptionValue = temp[key];\n              // oxlint-disable-next-line typescript/no-dynamic-delete\n              delete temp[key];\n            } else if (isPlainObject(temp[key])) {\n              temp = temp[key] as Record<string, unknown>;\n            } else {\n              break;\n            }\n          }\n        }\n      } else if (old in options) {\n        deprecatedOptionValue = options[old];\n        hasDeprecatedOption = true;\n        // oxlint-disable-next-line typescript/no-dynamic-delete\n        delete options[old];\n      }\n\n      if (hasDeprecatedOption) {\n        logger.warn(\n          `${colors.magenta(old)} is ${colors.yellow(\"deprecated\")}${\n            scope ? ` in ${scope}` : \"\"\n          }, please use ${colors.magenta(newOption)} instead.${msg ? ` ${msg}` : \"\"}`,\n        );\n\n        if (newOption.includes(\".\")) {\n          const keys = newOption.split(\".\");\n          let temp = options;\n\n          keys.forEach((key, index) => {\n            if (index === keys.length - 1) {\n              temp[key] = deprecatedOptionValue;\n            } else {\n              // Ensure level exists\n              // oxlint-disable-next-line typescript/prefer-nullish-coalescing\n              temp[key] ||= {};\n              temp = temp[key] as Record<string, unknown>;\n            }\n          });\n        } else {\n          options[newOption] = deprecatedOptionValue;\n        }\n      }\n    },\n\n    droppedLogger: ({ options, old, msg, new: newOption, scope }: DroppedLoggerOptions): void => {\n      let hasDroppedOption = false;\n\n      if (old.includes(\".\")) {\n        let temp = options;\n        const keys = old.split(\".\");\n\n        for (const [index, key] of keys.entries()) {\n          if (key in temp) {\n            if (index === keys.length - 1) {\n              hasDroppedOption = true;\n              // oxlint-disable-next-line typescript/no-dynamic-delete\n              delete temp[key];\n            } else if (isPlainObject(temp[key])) {\n              temp = temp[key] as Record<string, unknown>;\n            } else {\n              break;\n            }\n          }\n        }\n      } else if (old in options) {\n        hasDroppedOption = true;\n        // oxlint-disable-next-line typescript/no-dynamic-delete\n        delete options[old];\n      }\n\n      if (hasDroppedOption) {\n        logger.error(\n          `${colors.magenta(old)}${\n            scope ? ` in ${scope}` : \"\"\n          } is ${colors.red(\"no longer supported\")}${\n            newOption ? `, please use ${colors.magenta(newOption)} instead.` : \"\"\n          }${msg ? `\\n${msg}` : \"\"}`,\n        );\n      }\n    },\n  };\n};\n"],"mappings":";;;;AAwBA,MAAa,mBAAmB,SAA4B;CAC1D,MAAM,SAAS,IAAI,OAAO,IAAI;CAE9B,OAAO;EACL,mBAAmB,EACjB,SACA,KACA,KAAK,WACL,KACA,YACmC;GACnC,IAAI;GACJ,IAAI,sBAAsB;GAE1B,IAAI,IAAI,SAAS,GAAG,GAAG;IACrB,IAAI,OAAO;IACX,MAAM,OAAO,IAAI,MAAM,GAAG;IAE1B,KAAK,MAAM,CAAC,OAAO,QAAQ,KAAK,QAAQ,GACtC,IAAI,OAAO,MACT,IAAI,UAAU,KAAK,SAAS,GAAG;KAC7B,sBAAsB;KACtB,wBAAwB,KAAK;KAE7B,OAAO,KAAK;IACd,OAAO,IAAI,cAAc,KAAK,IAAI,GAChC,OAAO,KAAK;SAEZ;GAIR,OAAO,IAAI,OAAO,SAAS;IACzB,wBAAwB,QAAQ;IAChC,sBAAsB;IAEtB,OAAO,QAAQ;GACjB;GAEA,IAAI,qBAAqB;IACvB,OAAO,KACL,GAAG,OAAO,QAAQ,GAAG,EAAE,MAAM,OAAO,OAAO,YAAY,IACrD,QAAQ,OAAO,UAAU,GAC1B,eAAe,OAAO,QAAQ,SAAS,EAAE,WAAW,MAAM,IAAI,QAAQ,IACzE;IAEA,IAAI,UAAU,SAAS,GAAG,GAAG;KAC3B,MAAM,OAAO,UAAU,MAAM,GAAG;KAChC,IAAI,OAAO;KAEX,KAAK,SAAS,KAAK,UAAU;MAC3B,IAAI,UAAU,KAAK,SAAS,GAC1B,KAAK,OAAO;WACP;OAGL,KAAK,SAAS,CAAC;OACf,OAAO,KAAK;MACd;KACF,CAAC;IACH,OACE,QAAQ,aAAa;GAEzB;EACF;EAEA,gBAAgB,EAAE,SAAS,KAAK,KAAK,KAAK,WAAW,YAAwC;GAC3F,IAAI,mBAAmB;GAEvB,IAAI,IAAI,SAAS,GAAG,GAAG;IACrB,IAAI,OAAO;IACX,MAAM,OAAO,IAAI,MAAM,GAAG;IAE1B,KAAK,MAAM,CAAC,OAAO,QAAQ,KAAK,QAAQ,GACtC,IAAI,OAAO,MACT,IAAI,UAAU,KAAK,SAAS,GAAG;KAC7B,mBAAmB;KAEnB,OAAO,KAAK;IACd,OAAO,IAAI,cAAc,KAAK,IAAI,GAChC,OAAO,KAAK;SAEZ;GAIR,OAAO,IAAI,OAAO,SAAS;IACzB,mBAAmB;IAEnB,OAAO,QAAQ;GACjB;GAEA,IAAI,kBACF,OAAO,MACL,GAAG,OAAO,QAAQ,GAAG,IACnB,QAAQ,OAAO,UAAU,GAC1B,MAAM,OAAO,IAAI,qBAAqB,IACrC,YAAY,gBAAgB,OAAO,QAAQ,SAAS,EAAE,aAAa,KAClE,MAAM,KAAK,QAAQ,IACxB;EAEJ;CACF;AACF"}