     * `ctx.prisma`. `undefined` on a non-Prisma adapter.
     */
    readonly client?: unknown;
    /** Return `true` when this adapter can serve the given model key. */
    supports?(model: string): boolean;
    connect?(): Promise<void>;
    disconnect?(): Promise<void>;
}

