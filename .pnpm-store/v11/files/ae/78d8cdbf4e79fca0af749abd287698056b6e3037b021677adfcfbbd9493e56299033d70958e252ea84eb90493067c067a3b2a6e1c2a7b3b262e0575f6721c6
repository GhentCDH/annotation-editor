{"version":3,"file":"VPBanner.js","names":[],"sources":["../../../src/client/components/VPBanner.ts"],"sourcesContent":["import { isLinkExternal } from \"@vuepress/helper/client\";\nimport type { CSSProperties, FunctionalComponent } from \"vue\";\nimport { h } from \"vue\";\nimport { RouteLink, withBase } from \"vuepress/client\";\n\nimport \"../styles/vp-banner.scss\";\n\nexport interface BannerAction {\n  text: string;\n  link: string;\n  /** @default \"primary\" */\n  type?: \"primary\" | \"default\";\n}\n\nexport interface BannerProps {\n  /**\n   * Banner title\n   *\n   * 横幅标题\n   */\n  title: string;\n\n  /**\n   * Banner content\n   *\n   * 横幅内容\n   */\n  content?: string;\n\n  /**\n   * Banner icon\n   *\n   * 横幅图标\n   */\n  logo?: string;\n\n  /**\n   * Banner background\n   *\n   * 横幅背景\n   */\n  background?: string;\n\n  /**\n   * Banner font color\n   *\n   * 横幅字体颜色\n   */\n  color?: string;\n\n  /**\n   * Banner action\n   *\n   * 横幅操作\n   */\n  actions?: BannerAction[];\n}\n\nconst VPBanner: FunctionalComponent<BannerProps> = ({\n  title,\n  content = \"\",\n  logo = \"\",\n  background = \"\",\n  color = \"\",\n  actions = [],\n}) => {\n  const style: CSSProperties = {};\n\n  if (background) style.background = background;\n  if (color) style.color = color;\n\n  return h(\"div\", { class: \"vp-banner\", style }, [\n    logo\n      ? h(\"img\", {\n          class: \"vp-banner-logo\",\n          src: withBase(logo),\n          loading: \"lazy\",\n          \"no-view\": \"\",\n        })\n      : null,\n    h(\"div\", { class: \"vp-banner-body\" }, [\n      h(\"div\", { class: \"vp-banner-title\", innerHTML: title }),\n      h(\"div\", { class: \"vp-banner-content\", innerHTML: content }),\n      h(\n        \"div\",\n        { class: \"vp-banner-actions\" },\n        actions.map(({ link, text, type = \"primary\" }) =>\n          isLinkExternal(link)\n            ? h(\n                \"a\",\n                {\n                  class: [\"vp-banner-action\", type, \"no-external-link-icon\"],\n                  href: link,\n                  target: \"_blank\",\n                },\n                text,\n              )\n            : h(\n                RouteLink,\n                {\n                  class: [\"vp-banner-action\", type],\n                  to: link,\n                },\n                () => text,\n              ),\n        ),\n      ),\n    ]),\n  ]);\n};\n\nVPBanner.displayName = \"VPBanner\";\n\nexport default VPBanner;\n"],"mappings":";;;;;;AA0DA,MAAM,YAA8C,EAClD,OACA,UAAU,IACV,OAAO,IACP,aAAa,IACb,QAAQ,IACR,UAAU,CAAC,QACP;CACJ,MAAM,QAAuB,CAAC;CAE9B,IAAI,YAAY,MAAM,aAAa;CACnC,IAAI,OAAO,MAAM,QAAQ;CAEzB,OAAO,EAAE,OAAO;EAAE,OAAO;EAAa;CAAM,GAAG,CAC7C,OACI,EAAE,OAAO;EACP,OAAO;EACP,KAAK,SAAS,IAAI;EAClB,SAAS;EACT,WAAW;CACb,CAAC,IACD,MACJ,EAAE,OAAO,EAAE,OAAO,iBAAiB,GAAG;EACpC,EAAE,OAAO;GAAE,OAAO;GAAmB,WAAW;EAAM,CAAC;EACvD,EAAE,OAAO;GAAE,OAAO;GAAqB,WAAW;EAAQ,CAAC;EAC3D,EACE,OACA,EAAE,OAAO,oBAAoB,GAC7B,QAAQ,KAAK,EAAE,MAAM,MAAM,OAAO,gBAChC,eAAe,IAAI,IACf,EACE,KACA;GACE,OAAO;IAAC;IAAoB;IAAM;GAAuB;GACzD,MAAM;GACN,QAAQ;EACV,GACA,IACF,IACA,EACE,WACA;GACE,OAAO,CAAC,oBAAoB,IAAI;GAChC,IAAI;EACN,SACM,IACR,CACN,CACF;CACF,CAAC,CACH,CAAC;AACH;AAEA,SAAS,cAAc"}