dType\"> {\n  /** Force using PDFJS */\n  pdfjs?: boolean;\n\n  /** Hint message when PDF cannot be displayed */\n  hint?: string;\n}\n\nconst DEFAULT_PDF_JS_HINT = \"pdfjs url is not defined\";\n\n// oxlint-disable-next-line complexity\nexport const viewPDF = (\n  targetSelector: string | HTMLElement | null,\n  { url, title, hint = DEFAULT_PDF_JS_HINT, options = {}, pdfjs }: ViewPDFOptions,\n): HTMLElement | null => {\n  if (!globalThis.navigator?.userAgent) return null;\n\n  const { navigator } = globalThis;\n  const { userAgent } = navigator;\n\n  // Time to jump through hoops -- browser vendors do not make it easy to detect PDF support.\n\n  // Quick test for mobile devices.\n  const isMobileDevice = isiPad() || isMobile();\n\n  // Safari desktop requires special handling\n  const isSafariDesktop = !isMobileDevice && isSafari();\n\n  // Firefox started shipping PDF.js in Firefox 19. If this is Firefox 19 or greater, assume PDF.js is available\n  const isFirefoxWithPDFJS =\n    !isMobileDevice && /firefox/iu.test(userAgent) && userAgent.split(\"rv:\").length > 1\n      ? Number.parseInt(userAgent.split(\"rv:\")[1].split(\".\")[0], 10) > 18\n      : false;\n\n  // Determines whether PDF support is available\n  const supportsPDFs = navigator.pdfViewerEnabled || isFirefoxWithPDFJS;\n\n  const targetNode = getTargetElement(targetSelector);\n\n  if (!targetNode) {\n    logError(\"Target element cannot be determined\");\n\n    return null;\n  }\n\n  const fullLink = isLinkHttp(url) ? url : __VUEPRESS_DEV__ ? null : `${globalThis.origin}${url}`;\n\n  if (pdfjs) {\n    if (!fullLink) {\n      logError(\"PDF link is not accessible via internet.\");\n\n      return null;\n    }\n\n    if (!PDFJS_URL) {\n      targetNode.innerHTML = hint.replaceAll(String.raw`\\[url\\]`, fullLink);\n      logError(DEFAULT_PDF_JS_HINT);\n\n      return null;\n    }\n\n    return addPDFViewer(targetNode, {\n      embedType: \"pdfjs\",\n      url: fullLink,\n      options,\n      title,\n    });\n  }\n\n  if (supportsPDFs || !isMobileDevice) {\n    /*\n     * There is an edge case where Safari does not respect 302 redirect requests for PDF files when using <embed> element.\n     * Redirect appears to work fine when using <iframe> instead of <embed> (Addresses issue #210)\n     * Forcing Safari desktop to use iframe due to freezing bug in macOS 11 (Big Sur)\n     */\n    const embedType = isSafariDesktop ? \"iframe\" : \"embed\";\n\n    return addPDFViewer(targetNode, {\n      embedType,\n      url,\n      options,\n      title,\n    });\n  }\n\n  if (PDFJS_URL && fullLink) {\n    return addPDFViewer(targetNode, {\n      embedType: \"pdfjs\",\n      url: fullLink,\n      options,\n      title,\n    });\n  }\n\n  targetNode.innerHTML = hint.replaceAll(String.raw`\\[url\\]`, url);\n\n  logError(\"This browser does not support embedded PDFs\");\n\n  return null;\n};\n","export * from \"./iframeAllow.js\";\nexport * from \"./getLink.js\";\nexport * from \"./getMetaContent.js\";\nexport * from \"./popup.js\";\nexport * from \"./registerMse.js\";\nexport * from \"./viewPDF.js\";\n\nexport const DEFAULT_RATIO = 16 / 9;\n"],"mappings":";;;;AAAA,MAAa,mBACX;;;;ACDF,MAAa,kBAAkB,SAC7B,SAAS,cAA+B,cAAc,KAAK,GAAG,GAAG,aAAa,SAAS,KAAK;;;;ACC9F,IAAa,QAAb,MAAmB;CACjB,AAAiB;CACjB,AAAiB,gCAAgB,IAAI,IAA4B;CAGjE,cAAc;EACZ,MAAM,cAAc;EACpB,MAAM,mBAAmB,SAAS,cAA2B,IAAI,aAAa;EAE9E,IAAI,kBACF,KAAK,mBAAmB;OACnB;GACL,KAAK,mBAAmB,SAAS,cAAc,KAAK;GACpD,KAAK,iBAAiB,KAAK;GAC3B,SAAS,KAAK,OAAO,KAAK,gBAAgB;EAC5C;CACF;CAEA,KAAK,MAAc,UAA2B;EAC5C,MAAM,sBAAsB,SAAS,cAAc,KAAK;EACxD,MAAM,eAAe,SAAS,cAAc,KAAK;EACjD,MAAM,UAAU,KAAK,IAAI;EAEzB,KAAK,iBAAiB,OAAO,mBAAmB;EAChD,KAAK,cAAc,IAAI,SAAS,mBAAmB;EACnD,oBAAoB,YAAY;EAChC,oBAAoB,OAAO,YAAY;EACvC,oBAAoB,iBAAiB,eAAe;GAClD,KAAK,MAAM,OAAO;EACpB,CAAC;EACD,aAAa,YAAY;EACzB,aAAa,YAAY;EAEzB,IAAI,OAAO,aAAa,UACtB,iBAAiB;GACf,KAAK,MAAM,OAAO;EACpB,GAAG,QAAQ;EAGb,OAAO;CACT;CAEA,MAAM,SAAwB;EAC5B,IAAI,SAAS;GACX,MAAM,sBAAsB,KAAK,cAAc,IAAI,OAAO;GAE1D,IAAI,CAAC,qBAAqB;GAE1B