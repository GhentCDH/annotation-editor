       void renderNextWord();\n            }, 150);\n          } else if (isMounted) {\n            setTimeout(() => {\n              void getHitokoto();\n            }, 3000);\n          }\n        };\n\n        void renderNextWord();\n      });\n\n      void getHitokoto();\n    });\n\n    onUnmounted(() => {\n      isMounted = false;\n    });\n\n    return (): VNode[] => [\n      h(DropTransition, { appear: true, group: true, delay: 0.04 }, () => [\n        props.image\n          ? h(\"img\", {\n              key: \"light\",\n              class: [\"vp-blog-hero-image\", { light: props.imageDark }],\n              style: props.imageStyle,\n              src: props.image,\n              alt: props.alt ?? props.text,\n            })\n          : null,\n        props.imageDark\n          ? h(\"img\", {\n              key: \"dark\",\n              class: \"vp-blog-hero-image dark\",\n              style: props.imageStyle,\n              src: props.imageDark,\n              alt: props.alt ?? props.text,\n            })\n          : null,\n      ]),\n      h(DropTransition, { appear: true, delay: 0.08 }, () =>\n        props.text ? h(\"h1\", { class: \"vp-blog-hero-title\" }, props.text) : null,\n      ),\n      h(\"div\", { class: \"hitokoto\" }, [\n        h(\"p\", { class: \"hitokoto-text\" }, h(\"span\", display.value)),\n        h(\n          \"p\",\n          {\n            class: \"hitokoto-author\",\n            style: { opacity: display.value.length > 4 ? 1 : 0 },\n          },\n          `——「${author.value}」`,\n        ),\n      ]),\n    ];\n  },\n});\n"],"mappings":";;;;;AAqBA,+BAAe,gBAAgB;CAC7B,MAAM;CAEN,cAAc;CAEd,OAAO;;EAEL,MAAM;GACJ,MAAM;GACN,UAAU;EACZ;;EAGA,OAAO,CAAC,QAAQ,IAAI;;EAGpB,WAAW,CAAC,QAAQ,IAAI;;EAGxB,KAAK;;EAGL,YAAY,CAAC,QAAQ,MAAM;CAC7B;CAEA,MAAM,OAAO;EACX,MAAM,OAAO,IAAI,EAAE;EACnB,MAAM,UAAU,IAAI,EAAE;EACtB,MAAM,SAAS,IAAI,EAAE;EACrB,IAAI,YAAY;EAEhB,MAAM,oBACJ,MAAM,wBAAwB,EAC3B,MAAM,QAAQ,IAAI,KAAK,CAA4B,EACnD,MAAM,EAAE,MAAM,eAAe;GAC5B,KAAK,QAAQ;G