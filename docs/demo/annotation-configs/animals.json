{
  "$schema": "https://ghentcdh.github.io/crouton/schema/v1/resource.schema.json",
  "schemaVersion": 1,
  "kind": "custom",
  "name": "animals",
  "annotation": {
    "color": "#65a378",
    "target": "highlight",
    "allowedLinks": ["emotion"]
  },
  "columns": {
    "name": {
      "label": "name",
      "type": {
        "type": "string"
      }
    },
    "gender": {
      "label": "Gender",
      "type": {
        "type": "string"
      },
      "fieldInput": {
        "type": "select",
        "options": {
          "clearable": false,
          "storeValue": true,
          "emitObject": true,
          "values": [
            {
              "value": "female",
              "label": "Female"
            },
            {
              "value": "male",
              "label": "Male"
            }
          ]
        }
      }
    },
    "animalType": {
      "label": "Animal Type",
      "type": {
        "type": "string"
      },
      "fieldInput": {
        "type": "select",
        "options": {
          "clearable": false,
          "storeValue": true,
          "emitObject": true,
          "values": [
            {
              "value": "dog",
              "label": "Dog"
            },
            {
              "value": "parrot",
              "label": "parrot"
            }
          ]
        }
      }
    },
    "breed": {
      "label": "breed",
      "required": false,
      "type": {
        "type": "string"
      }
    },
    "species": {
      "label": "Species",
      "required": false,
      "type": {
        "type": "string"
      }
    }
  },
  "title": "Animals",
  "layout": {
    "form": {
      "items": [
        "name",
        {
          "id": "gender",
          "colspan": 4
        },
        {
          "id": "animalType",
          "colspan": 6
        },
        {
          "id": "breed",
          "colspan": 6
        },
        {
          "id": "species",
          "colspan": 6
        }
      ]
    },
    "view": {
      "items": [
        "name",
        {
          "id": "gender",
          "colspan": 4
        },
        {
          "id": "animalType",
          "colspan": 6
        },
        {
          "id": "breed",
          "colspan": 6
        },
        {
          "id": "species",
          "colspan": 6
        }
      ]
    }
  }
}
