{
  "name": "annotation-preview",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/annotation-preview/src",
  "projectType": "library",
  "tags": ["scope:annotation", "type:ui", "tech:vue", "feature:preview"],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "dependsOn": [
        {
          "projects": ["annotation-core", "annotation-ui"],
          "target": "build"
        }
      ]
    },
    "watch": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/packages/annotation-preview"
      ],
      "options": {
        "watch": true,
        "sourcemap": true,
        "config": "./vite.config.mts",
        "outDir": "../../dist/packages/annotation-preview"
      },
      "configurations": {
        "development": {
          "mode": "development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/coverage/unit"]
    }
  }
}
