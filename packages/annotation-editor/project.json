{
  "name": "annotation-editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/annotation-editor/src",
  "projectType": "library",
  "tags": ["scope:annotation", "type:ui", "tech:vue", "feature:editor"],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "dependsOn": [
        {
          "projects": ["annotation-core", "annotation-ui"],
          "target": "build"
        }
      ]
    },
    "watch": {
      "command": "vite build --watch --sourcemap",
      "options": {
        "cwd": "packages/annotation-ui"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/coverage/unit"]
    }
  }
}
