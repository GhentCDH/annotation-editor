{
  "name": "annotation-editor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/annotation-editor/src",
  "projectType": "library",
  "tags": ["scope:annotation", "type:ui", "tech:vue", "feature:editor"],
  "targets": {
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "build": {
      "outputs": [
        "{projectRoot}/{options.outDir}",
        "{workspaceRoot}/dist/packages/annotation-editor"
      ],
      "options": {
        "config": "./vite.config.mts",
        "outDir": "../../dist/packages/annotation-editor"
      },
      "configurations": {
        "production": {
          "mode": "production"
        },
        "development": {
          "mode": "development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/coverage/unit"]
    }
  }
}
