{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/merge-request.yml"]
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "watch",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck"
      },
      "include": [
        "packages/annotation-ui/**/*",
        "packages/annotation-preview/**/*"
      ]
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "devTargetName": "dev",
        "typecheckTargetName": "typecheck"
      },
      "include": [
        "packages/annotation-editor/**/*",
        "packages/annotation-core/**/*",
        "packages/annotation-vue/**/*",
        "packages/annotation-api/**/*"
      ]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "packages/annotation-api/**/*",
        "packages/annotation-core/**/*",
        "packages/annotation-editor/**/*",
        "packages/annotation-ui/**/*"
      ]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "test"
      },
      "include": [
        "packages/annotation-api/**/*",
        "packages/annotation-core/**/*",
        "packages/annotation-editor/**/*"
      ]
    }
  ],
  "release": {
    "projects": ["annotation-api", "annotation-core", "annotation-vue"],
    "version": {
      "conventionalCommits": true,
      "preVersionCommand": "npx nx run-many -t build"
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": {
        "file": "RELEASE_NOTES.md"
      }
    }
  },
  "migrate": {
    "agentic": false
  },
  "affected": {
    "legacy": true
  }
}
