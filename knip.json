{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "eslint": false,
  "vite": false,
  "vitest": false,
  "playwright": false,
  "ignoreBinaries": ["nx", "vuepress", "production"],
  "ignoreDependencies": [
    "@nx/vitest",
    "@tailwindcss/vite",
    "tailwindcss",
    "@vitejs/plugin-vue",
    "vite-plugin-dts",
    "vite-plugin-static-copy",
    "vite-tsconfig-paths",
    "vue-tsc",
    "@vue/test-utils",
    "@vitest/coverage-v8",
    "sass-embedded",
    "@swc-node/register",
    "@swc/core",
    "@swc/helpers",
    "prettier",
    "@eslint/js",
    "typescript-eslint",
    "@typescript-eslint/parser",
    "eslint-plugin-vue",
    "eslint-plugin-import-x",
    "jsonc-eslint-parser",
    "@nx/eslint-plugin",
    "vuepress",
    "@vuepress/bundler-vite",
    "vuepress-theme-hope"
  ],
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "packages/annotation-editor": { "entry": ["src/index.ts"], "project": ["src/**/*.{ts,vue}"] },
    "packages/annotation-core": { "entry": ["src/index.ts"], "project": ["src/**/*.{ts,vue}"] },
    "packages/annotation-ui": { "entry": ["src/index.ts"], "project": ["src/**/*.{ts,vue}"] },
    "packages/annotation-vue": { "entry": ["src/index.ts", "src/**/*.spec.ts"], "project": ["src/**/*.{ts,vue}"] },
    "packages/annotation-preview": { "entry": ["src/index.ts"], "project": ["src/**/*.{ts,vue}"] },
    "packages/annotation-api": { "entry": ["src/index.ts"], "project": ["src/**/*.{ts,vue}"] },
    "packages/annotation-editor-e2e": { "entry": ["src/**/main.ts", "src/**/*.spec.ts", "playwright.config.ts"], "project": ["src/**/*.{ts,vue}"] }
  }
}
